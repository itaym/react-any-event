{
  "name": "react-any-event",
  "version": "2.0.0",
  "description": "Create and handle new events for HTML elements",
  "main": "lib/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/index.d.ts",
  "sideEffects": false,
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/index.js"
    }
  },
  "scripts": {
    "test": "jest --config jestconfig.json",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "playground": "npm install --prefix playground && npm run dev --prefix playground"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itaym/react-any-event.git"
  },
  "keywords": [
    "React",
    "HTML",
    "utility",
    "props",
    "Events",
    "Custom"
  ],
  "author": "Itay Merchav",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/itaym/react-any-event/issues"
  },
  "homepage": "https://github.com/itaym/react-any-event#readme",
  "peerDependencies": {
    "react": "^16.3.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.3.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "prettier": "^3.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {}
}
