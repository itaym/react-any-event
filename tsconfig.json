{
  "compilerOptions": {
    "target": "es5",
    "module": "node16",
    "moduleResolution": "node16",
    "declaration": true,
    "downlevelIteration": true,
    "outDir": "./lib",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "jsx": "react",
    "lib": ["es2019", "dom"],
    "types": ["react", "node"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "lib", "**/__tests__/*"]
}
